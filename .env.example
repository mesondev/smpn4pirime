# Copy these values into the web server's environment configuration.
# Do not commit real credentials or point local development at production data.
SIMS_APP_ENV=local
SIMS_DB_HOST=127.0.0.1
SIMS_DB_PORT=3306
SIMS_DB_NAME=sims_db
SIMS_DB_USER=root
SIMS_DB_PASS=
# Backup folders must be private and outside every web document root.
SIMS_BACKUP_DIR=C:/laragon/data/sims_smpn4_backups
# Optional; backup.php can detect a Laragon installation automatically.
# SIMS_MYSQLDUMP=C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysqldump.exe
# Sender identity for replies to public contact messages.
SIMS_MAIL_FROM=smpn4pirime@gmail.com
SIMS_MAIL_FROM_NAME=SMP Negeri 4 Pirime
# Optional: use a folder outside the public web root for application logs.
# SIMS_LOG_DIR=C:/private/sims/logs
