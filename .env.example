# Copy these values into the web server's environment configuration.
# Do not commit real credentials or point local development at production data.
SIMS_APP_ENV=local
SIMS_DB_HOST=127.0.0.1
SIMS_DB_PORT=3306
SIMS_DB_NAME=sims_db
SIMS_DB_USER=root
SIMS_DB_PASS=
# Optional: use a folder outside the public web root for application logs.
# SIMS_LOG_DIR=C:/private/sims/logs
